generator client {
  provider = "prisma-client-js"
}

// Note: your editor may warn that `url` is "no longer supported" —
// that warning comes from a newer Prisma VS Code extension and only
// applies to Prisma 7. This project uses Prisma 6, where this is
// correct. Ignore the warning; `npx prisma validate` confirms it.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  loans Loan[]
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  copiesTotal     Int
  copiesAvailable Int
  createdAt       DateTime @default(now())

  loans Loan[]
}

enum LoanStatus {
  BORROWED
  RETURNED
}

model Loan {
  id         Int        @id @default(autoincrement())
  memberId   Int
  bookId     Int
  status     LoanStatus @default(BORROWED)
  borrowDate DateTime   @default(now())
  dueDate    DateTime
  returnDate DateTime?

  member Member @relation(fields: [memberId], references: [id])
  book   Book   @relation(fields: [bookId], references: [id])
}
